# Supabase (database + storage)
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Public CRM origin — used for magic links, billing buttons, and Meta WhatsApp URL button suffixes.
# Production: https://segmiq.com (not app.segmiq.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public domain (subdomains: [slug].yourdomain → /p/[slug])
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# Default country (ISO 3166-1 alpha-2) for phone numbers submitted without a country code
DEFAULT_COUNTRY_CODE=ZW

# IANA timezone for follow-up reminder date boundaries (due/prep batches)
DEFAULT_TIMEZONE=Africa/Harare

# Resend — both required for outbound email (From must use a domain verified in Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@segmiq.com
# Marketing form notifications (falls back to RESEND_FROM_EMAIL / sales@segmiq.com)
MARKETING_FROM_EMAIL=
MARKETING_INBOX_EMAIL=

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# Prereqs (do before production sends): Business Verification, WABA, phone
# number on the WABA, "Leadstaq" display name approved, System User token with
# whatsapp_business_messaging + whatsapp_business_management, 5 message templates
# approved in Business Manager, webhook "messages" field subscribed (see
# docs/meta-whatsapp-setup.md). Same Meta app as Facebook Lead Ads; reuse
# FACEBOOK_APP_SECRET for webhook signature verification.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
# Verify token for WhatsApp webhook (GET challenge). Can match FACEBOOK_WEBHOOK_VERIFY_TOKEN or be distinct.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Template names are hardcoded in lib/messaging/meta-whatsapp.ts (segmiq_* prefix).
# Language must match approved templates in Business Manager (typically `en`, not `en_US`).
META_WHATSAPP_TEMPLATE_LANGUAGE=en

# ---------------------------------------------------------------------------
# Temporary WhatsApp quick connection beta (defaults off)
WHATSAPP_TEMPORARY_WEB_ENABLED=false
# Private origin of the dedicated long-running gateway, not a Vercel function.
WHATSAPP_GATEWAY_URL=http://localhost:8787
# Same random value on web + gateway; minimum 32 characters.
WHATSAPP_GATEWAY_SHARED_SECRET=
# Exactly 32 random bytes encoded as base64, or 64 hexadecimal characters. Web only.
WHATSAPP_SESSION_ENCRYPTION_KEY=
# Gateway-only callback and runtime configuration.
SEGMIQ_INTERNAL_BASE_URL=http://localhost:3000
WHATSAPP_GATEWAY_PORT=8787
# Per connected business number; protects the manual-only beta from accidental loops.
WHATSAPP_GATEWAY_MAX_SENDS_PER_MINUTE=30
# Comma-separated HTTPS host allowlist for outbound document downloads.
WHATSAPP_GATEWAY_MEDIA_HOSTS=media.example.com

# ---------------------------------------------------------------------------
# Facebook Lead Ads — OAuth + webhook (add redirect URL in Meta app: Valid OAuth Redirect URIs)
# OAuth scopes in code include ads_read and pages_manage_ads (Campaigns / Marketing API + Page-linked ads).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/oauth/callback
FACEBOOK_WEBHOOK_VERIFY_TOKEN=your-verify-token
# Meta Cloud API and Lead Ads use the same Graph version.
FACEBOOK_API_VERSION=v19.0

# ---------------------------------------------------------------------------
# Cloudflare R2 — object storage for project photos and hero images
# Create a bucket at dash.cloudflare.com → R2 → Create bucket
# Create API token with Object Read & Write permissions
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=leadstaq-media
CLOUDFLARE_R2_PUBLIC_URL=  # e.g. https://media.leadstaq.tech (custom domain on R2 bucket)

# Long random string for authenticating cron requests (Vercel Cron and manual triggers).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# Anthropic Claude — AI features (lead briefing, form generation, win insights)
ANTHROPIC_API_KEY=your_anthropic_api_key

# SegmiQ Agent LLM. Gemini Flash is the default free testing option (tool calling).
# Get a Gemini key at https://aistudio.google.com/apikey
# AGENT_LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.6-flash
#
# Groq — free developer-plan fallback when Gemini hits 429.
# Get a key at https://console.groq.com/keys
# Set AGENT_LLM_PROVIDER=groq to use Groq as the primary model.
# AGENT_LLM_FALLBACK=groq
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-20b
# Other Groq models with tool calling: llama-3.3-70b-versatile, qwen/qwen3.6-27b

# ---------------------------------------------------------------------------
# Twilio (deprecated — kept for rollback; outbound WhatsApp uses Meta Cloud API above)
# Do not remove from production until Meta migration is verified; see `lib/messaging/provider.ts` rollback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID_NEW_LEAD_SALESPERSON=
TWILIO_CONTENT_SID_NEW_LEAD_MANAGER=
TWILIO_CONTENT_SID_DEAL_WON=
TWILIO_CONTENT_SID_FOLLOW_UP_REMINDER=
TWILIO_CONTENT_SID_UNCONTACTED_LEAD_ALERT=


cd sales-app
npm run build
npx cap sync android
$env:JAVA_HOME = "sales-app\.tools\jdk-21"
$env:ANDROID_HOME = "$env:LOCALAPPDATA\Android\Sdk"
cd android; .\gradlew.bat assembleDebug
Copy-Item app\build\outputs\apk\debug\app-debug.apk ..\..\public\downloads\segmiq-sales.apk -Force
